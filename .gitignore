# local tooling and OS noise
.claude/
.DS_Store
__pycache__/
*.pyc
.venv/


# runtime state and anything with credentials in it
.env
*.db
*.db-wal
*.db-shm

# working notes for outbound submissions, not part of the product
submissions/

# Deployment configuration stays private. It describes the machine this runs
# on, which is no part of the product, and publishing it hands an attacker a
# map for nothing in return.
deploy/

# internal working guidance, never published
CLAUDE.md
submissions/

# names our own estate, never committed
.leakpatterns

# internal tooling, never published
leakscan.sh
.leakpatterns

# the scanner lives outside this project; it must never ship with it
**/leakscan.sh

# internal operational docs: paths, ports, hosts, service names, box layout.
# NEVER published. This directory is both the deployment AND the git repo,
# so anything not ignored here goes public on the next push.
internal/

# build artefacts, never committed
*.egg-info/
dist/
build/
dataset/
._*
